      "metadata": {}
     },
     "create_time": 1735689603.0,
     "content": {
      "content_type": "text",
      "parts": [
       "What about lifetimes?"
      ]
     },
     "status": "finished_successfully",
     "metadata": {
      "is_visually_hidden_from_conversation": false
     }
    },
    "parent": "aaa-111-n1",
    "children": [
     "aaa-111-n3"
