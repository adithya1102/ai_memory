     "content": {
      "content_type": "text",
      "parts": [
       "Can you explain ownership in Rust? I keep fighting the borrow checker."
      ]
     },
     "status": "finished_successfully",
     "metadata": {
      "is_visually_hidden_from_conversation": false
     }
    },
    "parent": "sys",
    "children": [
